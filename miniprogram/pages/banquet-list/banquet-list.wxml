<view class="page">
  <view class="screen-title">收取礼金 <text class="subtle">宴席账本</text></view>
  <view class="toolbar"><view class="month-box"><picker mode="selector" range="{{months}}" value="{{monthIndex}}" bindchange="chooseMonth">{{months[monthIndex]}}　⌄</picker></view><text class="subtle">{{items.length}} 场宴席</text></view>
  <view class="primary-button" bindtap="createBanquet">＋　新建宴席</view>
  <view wx:if="{{items.length}}">
    <view wx:for="{{items}}" wx:key="id" class="list-card" data-id="{{item.id}}" bindtap="openBanquet">
      <view class="list-icon">囍</view><view class="list-content"><text class="list-name">{{item.name}}</text><text class="list-meta">{{item.date}}　{{item.location}}</text><view class="row-actions" catchtap="stopTap"><text data-id="{{item.id}}" catchtap="editBanquet">编辑</text><text data-id="{{item.id}}" catchtap="deleteBanquet">删除</text></view></view>
      <view class="list-total">¥{{item.total}}<text class="list-count">{{item.count}} 人</text></view><text class="chevron">›</text>
    </view>
  </view>
  <view wx:else class="empty-card"><text class="empty-mark">囍</text><text>还没有宴席记录</text><text class="empty-hint">新建宴席后即可登记收到的礼金</text></view>
</view>
