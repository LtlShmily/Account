<view class="page home-page">
  <view class="hero">
    <view class="hero-cloud cloud-one">❋</view><view class="hero-cloud cloud-two">⌁</view>
    <text class="hero-title">礼金账本</text><text class="hero-subtitle">记录人情往来 · 留住每份心意</text><view class="hero-seal">囍</view>
  </view>
  <view class="entry-row">
    <view class="entry-card entry-receive" bindtap="openReceived"><view class="entry-icon">收</view><text class="entry-title">收取礼金</text><text class="entry-caption">记录宴席收到的礼金</text><text class="entry-arrow">›</text></view>
    <view class="entry-card entry-send" bindtap="openSent"><view class="entry-icon">送</view><text class="entry-title">送出礼金</text><text class="entry-caption">记录送给亲友的礼金</text><text class="entry-arrow">›</text></view>
  </view>
  <view class="section-title"><text>收支统计</text><text class="section-note">累计往来</text></view>
  <view class="summary-card">
    <view class="summary-item"><text class="summary-label">累计收取</text><text class="summary-value red">¥{{received}}</text></view><view class="summary-divider"></view>
    <view class="summary-item"><text class="summary-label">累计送出</text><text class="summary-value teal">¥{{sent}}</text></view><view class="summary-divider"></view>
    <view class="summary-item"><text class="summary-label">往来净额</text><text class="summary-value dark">¥{{balance}}</text></view>
  </view>
  <view class="home-quick-actions">
    <view class="home-quick-action share-action">分享</view>
    <view class="home-quick-action export-action" bindtap="exportData">导出</view>
  </view>
  <view class="list-mode-switch {{listDisplayMode === 'all' ? 'list-mode-switch-all' : ''}}" bindtap="toggleListDisplayMode"><text class="list-mode-switch-label">明细展示模式</text><text class="list-mode-switch-value">{{listDisplayModeLabel}}　切换 ›</text></view>
  <view class="section-title recent-heading"><text>近期记录</text><text class="section-note">最近 6 笔</text></view>
  <view wx:if="{{recent.length}}" class="recent-card">
    <view wx:for="{{recent}}" wx:key="id" class="recent-row"><view class="record-badge {{item.typeClass}}">{{item.type}}</view><view class="recent-main"><text class="recent-name">{{item.name}}</text><text class="recent-detail">{{item.detail}} · {{item.date}}</text></view><text class="recent-amount {{item.typeClass}}">{{item.amount}}</text></view>
  </view>
  <view wx:else class="empty-card"><text class="empty-mark">✦</text><text>还没有礼金记录</text><text class="empty-hint">从上方选择收取或送出礼金开始记账</text></view>
  <view class="footer-note">一笔一记，心意有迹可循</view>
</view>
