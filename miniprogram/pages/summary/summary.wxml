<view class="page summary-page">
  <view class="screen-title">收支总计</view>
  <view class="summary-card summary-overview">
    <view class="summary-item"><text class="summary-label">总收入</text><text class="summary-value red">¥{{received}}</text></view><view class="summary-divider"></view>
    <view class="summary-item"><text class="summary-label">总支出</text><text class="summary-value teal">¥{{sent}}</text></view><view class="summary-divider"></view>
    <view class="summary-item"><text class="summary-label">总差额</text><text class="summary-value dark">¥{{balance}}</text></view>
  </view>
  <view class="summary-explain">按姓名合并收礼与送礼对象；每一笔记录单独占一列，可左右滑动查看。</view>
  <view class="toolbar"><view class="search-box">⌕　<input placeholder="搜索姓名" value="{{keyword}}" bindinput="search" /></view><text class="subtle">{{rows.length}} 人</text></view>
  <scroll-view wx:if="{{rows.length}}" class="summary-scroll" scroll-x="true" enable-flex="true">
    <view class="summary-grid" style="width:{{tableWidth}}rpx">
      <view class="summary-table-head">
        <view class="summary-name-head">姓名</view>
        <view wx:for="{{columns}}" wx:key="key" class="summary-data-cell summary-head-cell {{item.className}}">{{item.label}}</view>
      </view>
      <view wx:for="{{rows}}" wx:key="key" class="summary-table-row">
        <view class="summary-name-cell">{{item.name}}</view>
        <view wx:for="{{item.cells}}" wx:for-item="cell" wx:key="key" class="summary-data-cell {{cell.className}}"><text>{{cell.amount}}</text><text wx:if="{{cell.date}}" class="summary-date">{{cell.date}}</text></view>
      </view>
    </view>
  </scroll-view>
  <view wx:else class="empty-card"><text class="empty-mark">✦</text><text>还没有收支记录</text><text class="empty-hint">添加收礼或送礼记录后，这里会按姓名汇总</text></view>
</view>
