<view class="page summary-page">
  <view class="summary-card summary-overview">
    <view class="summary-item"><text class="summary-label red-label">总收入</text><text class="summary-value red">¥ {{received}}</text></view>
    <view class="summary-divider"></view>
    <view class="summary-item"><text class="summary-label teal-label">总支出</text><text class="summary-value teal">¥ {{sent}}</text></view>
    <view class="summary-divider"></view>
    <view class="summary-item"><text class="summary-label brown-label">总差额</text><text class="summary-value dark">¥ {{balance}}</text></view>
  </view>
  <view class="toolbar summary-toolbar">
    <view class="search-box">⌕　<input placeholder="搜索姓名" value="{{keyword}}" bindinput="search" /></view>
    <text class="subtle">共 {{rows.length}} 人</text>
  </view>
  <view wx:if="{{rows.length}}" class="people-list">
    <view wx:for="{{rows}}" wx:key="key" class="person-summary-row" data-name="{{item.name}}" bindtap="openPerson">
      <view class="person-avatar">{{item.initial}}</view>
      <view class="person-summary-main">
        <text class="person-name">{{item.name}}</text>
        <view class="person-sums"><text>收 {{item.income}}</text><text>支 {{item.expense}}</text></view>
      </view>
      <view class="person-balance-wrap"><text class="person-balance-label">差额</text><text class="person-balance {{item.balanceClass}}">{{item.balance}}</text></view>
      <text class="person-chevron">›</text>
    </view>
  </view>
  <view wx:else class="empty-card"><text class="empty-mark">✦</text><text>{{keyword ? '没有匹配的姓名' : '还没有收支记录'}}</text><text class="empty-hint">添加收礼或送礼记录后，这里会按姓名汇总</text></view>
</view>
