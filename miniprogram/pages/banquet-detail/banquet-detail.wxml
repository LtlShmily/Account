<view class="page">
  <view class="detail-head"><view class="detail-name">{{name}}</view><view class="detail-meta">▦　{{date}}　⌖　{{location}}</view><view class="row-actions" style="margin-top:16rpx"><text bindtap="editBanquet">编辑宴席信息</text></view></view>
  <view class="total-banner"><view><view class="subtle">收到礼金合计</view><view class="detail-meta">{{count}} 位来宾</view></view><text class="total-number">¥{{total}}</text></view>
  <view class="inline-help">直接在表格中填写；录入一行后会自动出现下一行，填完整并离开单元格即保存。</view>
  <view class="primary-button import-guests-button" bindtap="importGuests">批量导入</view>
  <view class="toolbar"><view class="search-box">⌕　<input placeholder="搜索来宾姓名" value="{{keyword}}" bindinput="search" /></view></view>
  <view class="batch-toolbar">
    <text class="batch-mode-toggle" bindtap="toggleBatchMode">{{batchMode ? '完成' : '批量操作'}}</text>
    <view wx:if="{{batchMode}}" class="batch-toolbar-actions"><text bindtap="selectAllVisible">全选当前</text><text>已选 {{selectedIds.length}} 条</text><text bindtap="exportSelected">复制导出</text><text class="batch-delete-action" bindtap="deleteSelected">删除</text></view>
  </view>
  <view class="table banquet-guest-table">
    <view class="table-head"><text class="cell cell-name">姓名</text><text class="cell">金额</text><text class="cell">备注</text><text class="cell cell-action">{{batchMode ? '选' : '操作'}}</text></view>
    <view wx:for="{{guests}}" wx:key="id" id="guest-{{item.recordId}}" class="table-row {{item.isDraft ? 'draft-row' : ''}} {{item.recordId === sourceGuestId ? 'source-guest-row' : ''}}">
      <view class="cell cell-name"><input class="cell-input" data-id="{{item.id}}" data-field="name" value="{{item.name}}" placeholder="姓名" maxlength="40" bindinput="onCellInput" bindblur="onCellBlur" /><text wx:if="{{!item.isDraft}}" class="cell-sub">{{item.date}}</text></view>
      <view class="cell"><input class="cell-input cell-input-amount" type="digit" data-id="{{item.id}}" data-field="amount" value="{{item.amount}}" placeholder="金额" maxlength="12" bindinput="onCellInput" bindblur="onCellBlur" /></view>
      <view class="cell"><input class="cell-input" data-id="{{item.id}}" data-field="address" value="{{item.address}}" placeholder="地址或备注" maxlength="80" bindinput="onCellInput" bindblur="onCellBlur" /></view>
      <view class="cell cell-action"><text wx:if="{{batchMode && !item.isDraft}}" class="row-select-mark" data-id="{{item.recordId}}" catchtap="toggleSelected">{{item.selected ? '☑' : '□'}}</text><text wx:elif="{{!item.isDraft}}" class="delete-cell compact-delete" data-id="{{item.recordId}}" catchtap="deleteGuest">删</text><text wx:else class="draft-mark">＋</text></view>
    </view>
  </view>
</view>
