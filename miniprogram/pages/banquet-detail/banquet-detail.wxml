<view class="page" bindtouchstart="markTouch">
  <view class="detail-head"><view class="detail-name">{{name}}</view><view class="detail-meta">▦　{{date}}　⌖　{{location}}</view><view class="row-actions" style="margin-top:16rpx"><text bindtap="editBanquet">编辑宴席信息</text></view></view>
  <view class="total-banner"><view><view class="subtle">收到礼金合计</view><view class="detail-meta">{{count}} 位来宾</view></view><text class="total-number">¥{{total}}</text></view>
  <view class="inline-help">每页显示 50 条。直接填写表格；输入有效姓名和金额后自动补空行，填完整并离开单元格即保存。按 Tab 或键盘“下一项”到页尾时，会跳到下一页的空行。</view>
  <view class="import-actions">
    <view class="primary-button import-guests-button import-action-button" bindtap="importGuests">批量导入</view>
    <view class="excel-import-action import-action-button" bindtap="importGuestsFromExcel">Excel 导入</view>
  </view>
  <text class="excel-import-hint">支持 .xlsx；表头需包含姓名和金额，备注或地址可选</text>
  <view class="toolbar"><view class="search-box">⌕　<input placeholder="搜索来宾姓名" value="{{keyword}}" bindinput="search" /></view></view>
  <view class="batch-toolbar">
    <text class="batch-mode-toggle" bindtap="toggleBatchMode">{{batchMode ? '完成' : '批量操作'}}</text>
    <view wx:if="{{batchMode}}" class="batch-toolbar-actions"><text bindtap="selectAllVisible">全选本页</text><text>已选 {{selectedIds.length}} 条</text><text bindtap="exportSelected">复制导出</text><text class="batch-delete-action" bindtap="deleteSelected">删除</text></view>
  </view>
  <view wx:if="{{totalPages > 1}}" class="list-pagination">
    <view class="pagination-action {{currentPage <= 1 ? 'pagination-disabled' : ''}}" bindtap="firstPage">首页</view>
    <view class="pagination-action {{currentPage <= 1 ? 'pagination-disabled' : ''}}" bindtap="previousPage">上一页</view>
    <text class="pagination-count">共 {{count}} 笔　{{currentPage}}/{{totalPages}} 页</text>
    <view class="pagination-jump"><input type="number" value="{{pageInput}}" bindinput="onPageInput" confirm-type="done" /><text bindtap="goToPage">跳页</text></view>
    <view class="pagination-action" bindtap="lastPage">尾页</view>
    <view class="pagination-action {{currentPage >= totalPages ? 'pagination-disabled' : ''}}" bindtap="nextPage">下一页</view>
  </view>
  <view class="table banquet-guest-table">
    <view class="table-head"><text class="cell cell-name">姓名</text><text class="cell">金额</text><text class="cell">备注</text><text class="cell cell-action">{{batchMode ? '选' : '操作'}}</text></view>
    <view wx:for="{{guests}}" wx:key="id" data-index="{{item.globalIndex}}" id="guest-{{item.recordId || item.id}}" class="table-row {{item.isDraft ? 'draft-row' : ''}} {{item.recordId === sourceGuestId ? 'source-guest-row' : ''}}">
      <view class="cell cell-name"><input class="cell-input" data-id="{{item.id}}" data-field="name" value="{{item.name}}" placeholder="姓名" maxlength="40" confirm-type="next" focus="{{focusTargetId === item.id && focusTargetField === 'name'}}" bindinput="onCellInput" bindblur="onCellBlur" bindfocus="onCellFocus" bindconfirm="onCellConfirm" /><text wx:if="{{!item.isDraft}}" class="cell-sub">{{item.date}}</text></view>
      <view class="cell"><input class="cell-input cell-input-amount" type="digit" data-id="{{item.id}}" data-field="amount" value="{{item.amount}}" placeholder="金额" maxlength="12" confirm-type="next" focus="{{focusTargetId === item.id && focusTargetField === 'amount'}}" bindinput="onCellInput" bindblur="onCellBlur" bindfocus="onCellFocus" bindconfirm="onCellConfirm" /></view>
      <view class="cell"><input class="cell-input" data-id="{{item.id}}" data-field="address" value="{{item.address}}" placeholder="地址或备注" maxlength="80" confirm-type="next" focus="{{focusTargetId === item.id && focusTargetField === 'address'}}" bindinput="onCellInput" bindblur="onCellBlur" bindfocus="onCellFocus" bindconfirm="onCellConfirm" /></view>
      <view class="cell cell-action"><text wx:if="{{batchMode && !item.isDraft}}" class="row-select-mark" data-id="{{item.recordId}}" catchtap="toggleSelected">{{item.selected ? '☑' : '□'}}</text><text wx:elif="{{!item.isDraft}}" class="delete-cell compact-delete" data-id="{{item.recordId}}" catchtap="deleteGuest">删</text><text wx:else class="draft-mark">＋</text></view>
    </view>
  </view>
  <view wx:if="{{!guests.length && keyword}}" class="empty-card"><text>没有符合条件的来宾</text></view>
  <view wx:if="{{totalPages > 1}}" class="list-pagination list-pagination-bottom">
    <view class="pagination-action {{currentPage <= 1 ? 'pagination-disabled' : ''}}" bindtap="firstPage">首页</view>
    <view class="pagination-action {{currentPage <= 1 ? 'pagination-disabled' : ''}}" bindtap="previousPage">上一页</view>
    <text class="pagination-count">{{currentPage}} / {{totalPages}} 页</text>
    <view class="pagination-action" bindtap="lastPage">尾页</view>
    <view class="pagination-action {{currentPage >= totalPages ? 'pagination-disabled' : ''}}" bindtap="nextPage">下一页</view>
  </view>
</view>
