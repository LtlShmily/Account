<view class="page person-detail-page">
  <view class="person-detail-card">
    <view class="person-detail-heading"><view class="person-avatar person-detail-avatar">{{initial}}</view><text class="person-detail-name">{{name}}</text></view>
    <view class="person-total-card">
      <view class="summary-item"><text class="summary-label">收入合计</text><text class="person-total-value red">¥ {{income}}</text></view>
      <view class="summary-divider"></view>
      <view class="summary-item"><text class="summary-label">支出合计</text><text class="person-total-value teal">¥ {{expense}}</text></view>
      <view class="summary-divider"></view>
      <view class="summary-item"><text class="summary-label">差额</text><text class="person-total-value {{balanceClass}}">¥ {{balance}}</text></view>
    </view>
  </view>
  <view class="section-title transaction-heading"><text>收支明细</text><text class="section-note">共 {{rows.length}} 笔</text></view>
  <view wx:if="{{rows.length}}" class="transaction-list">
    <view wx:for="{{rows}}" wx:key="key" class="transaction-row" data-type="{{item.type}}" data-id="{{item.id}}" bindtap="openSource">
      <view class="transaction-type-icon {{item.type}}">{{item.typeMark}}</view>
      <view class="transaction-main">
        <view class="transaction-title-line"><text class="transaction-type-label">{{item.typeLabel}}</text><text class="transaction-date">{{item.date}}</text></view>
        <text class="transaction-context">{{item.context}}</text>
        <text wx:if="{{item.address}}" class="transaction-address">{{item.address}}</text>
        <text wx:if="{{item.gift}}" class="transaction-gift">礼品：{{item.gift}}</text>
      </view>
      <view class="transaction-trailing"><text class="transaction-amount {{item.type}}">{{item.amountPrefix}}¥{{item.amount}}</text><text class="transaction-chevron">›</text></view>
    </view>
  </view>
  <view wx:else class="empty-card"><text>暂无收支明细</text></view>
</view>
