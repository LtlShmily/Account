page { min-height: 100%; background: #fbf6ef; color: #302723; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; }
view, text, input, textarea, button { box-sizing: border-box; }
.page { min-height: 100vh; padding: 0 30rpx 60rpx; }
.hero { position: relative; height: 310rpx; margin: 0 -30rpx 30rpx; padding: 70rpx 42rpx 0; overflow: hidden; color: #fff5e7; text-align: center; background: linear-gradient(135deg,#c6221e,#a91317 70%,#8e1118); }
.hero:after { content: ""; position: absolute; width: 520rpx; height: 150rpx; bottom: -74rpx; left: 50%; transform: translateX(-50%); border: 1rpx solid rgba(255,223,174,.35); border-radius: 50%; box-shadow: 0 -12rpx 0 rgba(255,223,174,.06),0 -25rpx 0 rgba(255,223,174,.06); }
.hero-title { display:block; font-size:52rpx; letter-spacing:12rpx; font-family:serif; font-weight:600; text-shadow:0 2rpx 8rpx rgba(79,0,0,.25); }
.hero-subtitle { display:block; margin-top:12rpx; color:#f5d9bb; font-size:23rpx; letter-spacing:3rpx; }
.hero-cloud { position:absolute; color:rgba(255,225,181,.6); font-size:70rpx; }.cloud-one { left:34rpx; top:27rpx; }.cloud-two { right:42rpx; bottom:30rpx; font-size:90rpx; }
.hero-seal { position:absolute; right:42rpx; top:50rpx; width:64rpx; height:64rpx; line-height:58rpx; border:2rpx solid #f2c987; color:#f2c987; font-size:36rpx; transform:rotate(8deg); }
.entry-row { display:flex; gap:18rpx; margin-bottom:34rpx; }
.entry-card { position:relative; flex:1; min-height:212rpx; padding:24rpx 20rpx; border-radius:18rpx; color:white; box-shadow:0 8rpx 20rpx rgba(85,43,25,.12); overflow:hidden; }
.entry-card:after { content:""; position:absolute; width:170rpx; height:170rpx; right:-56rpx; bottom:-90rpx; border:1rpx solid rgba(255,255,255,.35); border-radius:50%; box-shadow:0 0 0 12rpx rgba(255,255,255,.05),0 0 0 25rpx rgba(255,255,255,.05); }
.entry-receive { background:linear-gradient(145deg,#d52b24,#ae1717); }.entry-send { background:linear-gradient(145deg,#347c7a,#205a60); }
.entry-icon { display:flex; align-items:center; justify-content:center; width:54rpx; height:54rpx; margin-bottom:14rpx; border:1rpx solid rgba(255,244,221,.72); border-radius:50%; color:#fff0d5; font-size:26rpx; }
.entry-title { display:block; font-size:32rpx; font-weight:600; letter-spacing:2rpx; }.entry-caption { display:block; margin-top:8rpx; color:rgba(255,255,255,.78); font-size:21rpx; }.entry-arrow { position:absolute; right:20rpx; bottom:12rpx; font-size:40rpx; color:#f9dfc7; }
.section-title { display:flex; align-items:center; justify-content:space-between; margin:26rpx 2rpx 16rpx; color:#5b3930; font-size:29rpx; font-weight:600; }.section-note { color:#a99b8e; font-size:21rpx; font-weight:400; }
.summary-card,.recent-card,.empty-card,.panel { border:1rpx solid #eee2d4; border-radius:18rpx; background:rgba(255,255,255,.76); box-shadow:0 5rpx 18rpx rgba(79,44,20,.035); }
.summary-card { display:flex; align-items:center; justify-content:space-around; padding:26rpx 8rpx; }.summary-item { flex:1; display:flex; flex-direction:column; align-items:center; gap:10rpx; }.summary-label { color:#948579; font-size:21rpx; }.summary-value { font-family:Georgia,serif; font-size:27rpx; font-weight:600; }.red { color:#bb211d; }.teal { color:#286b6e; }.dark { color:#694e34; }.summary-divider { height:54rpx; border-left:1rpx solid #eee3d7; }
.recent-heading { margin-top:34rpx; }.recent-card { padding:0 20rpx; }.recent-row { display:flex; align-items:center; min-height:105rpx; border-bottom:1rpx solid #f2eae1; }.recent-row:last-child { border-bottom:0; }.record-badge { display:flex; align-items:center; justify-content:center; width:46rpx; height:46rpx; margin-right:18rpx; border-radius:13rpx; color:white; font-size:22rpx; }.record-badge.receive { background:#bd2722; }.record-badge.send { background:#2d7373; }.recent-main { flex:1; min-width:0; display:flex; flex-direction:column; gap:8rpx; }.recent-name { color:#382e28; font-size:25rpx; }.recent-detail { overflow:hidden; color:#a29488; font-size:20rpx; white-space:nowrap; text-overflow:ellipsis; }.recent-amount { font-size:25rpx; font-weight:600; }.empty-card { display:flex; flex-direction:column; align-items:center; padding:45rpx 20rpx; color:#86796e; font-size:25rpx; }.empty-mark { margin-bottom:12rpx; color:#c8a77b; font-size:44rpx; }.empty-hint { margin-top:12rpx; color:#b1a59b; font-size:21rpx; }.footer-note { margin-top:34rpx; text-align:center; color:#c0b1a1; font-size:20rpx; letter-spacing:2rpx; }
.toolbar { display:flex; align-items:center; gap:14rpx; margin:20rpx 0; }.search-box,.month-box { height:72rpx; display:flex; align-items:center; padding:0 20rpx; border:1rpx solid #eadfd2; border-radius:40rpx; background:#fffdf9; color:#796d63; font-size:23rpx; }.search-box { flex:1; }.search-box input { width:100%; font-size:23rpx; }.month-box { min-width:190rpx; justify-content:center; }.month-box picker { width:100%; text-align:center; }
.primary-button { display:flex; align-items:center; justify-content:center; min-height:84rpx; margin:24rpx 0; border-radius:48rpx; color:white; font-size:29rpx; letter-spacing:2rpx; font-weight:600; background:linear-gradient(100deg,#ce2923,#b81819); box-shadow:0 7rpx 15rpx rgba(172,31,25,.18); }.primary-button.teal-button { background:linear-gradient(100deg,#367e7d,#205d62); box-shadow:0 7rpx 15rpx rgba(36,105,108,.16); }.secondary-action { color:#ae2420; font-size:22rpx; }
.list-card { display:flex; align-items:center; gap:16rpx; margin-bottom:16rpx; padding:22rpx 18rpx; border:1rpx solid #eee2d5; border-radius:16rpx; background:#fffdf9; }.list-icon { display:flex; align-items:center; justify-content:center; flex:none; width:56rpx; height:56rpx; border-radius:14rpx; background:#c12620; color:white; font-size:25rpx; }.list-content { flex:1; min-width:0; }.list-name { display:block; overflow:hidden; color:#49342d; font-size:27rpx; font-weight:600; white-space:nowrap; text-overflow:ellipsis; }.list-meta { display:block; margin-top:8rpx; color:#a2968a; font-size:21rpx; }.list-total { text-align:right; color:#bd211d; font-size:26rpx; font-weight:600; }.list-count { display:block; margin-top:7rpx; color:#a99b8f; font-size:20rpx; font-weight:400; }.chevron { color:#bb332c; font-size:36rpx; }
.screen-title { margin:16rpx 0 22rpx; color:#4b342d; font-size:34rpx; font-weight:600; }.subtle { color:#9b8c7f; font-size:22rpx; }.total-banner { display:flex; align-items:center; justify-content:space-between; padding:22rpx 24rpx; border-radius:18rpx; background:#fff; border:1rpx solid #eee3d7; }.total-number { color:#ba211d; font-size:38rpx; font-weight:700; }.row-actions { display:flex; gap:18rpx; color:#a43a31; font-size:21rpx; }
.detail-head { padding:22rpx; margin-bottom:20rpx; border-radius:18rpx; border:1rpx solid #f0e2d1; background:linear-gradient(135deg,#fffdf8,#fff7eb); }.detail-name { color:#a9231f; font-size:30rpx; font-weight:600; }.detail-meta { margin-top:12rpx; color:#7e7065; font-size:21rpx; }.table { overflow:hidden; border-radius:14rpx; border:1rpx solid #eadfd2; background:#fffdf9; }.table-head,.table-row { display:flex; align-items:center; min-height:82rpx; border-bottom:1rpx solid #eee5db; }.table-head { color:white; background:#b9231f; font-size:23rpx; font-weight:600; }.table-head.teal-head { background:#286a6e; }.table-row:last-child { border-bottom:0; }.cell { flex:1; padding:8rpx 10rpx; text-align:center; font-size:22rpx; overflow:hidden; text-overflow:ellipsis; }.cell-name { flex:1.2; text-align:left; padding-left:20rpx; }.cell-amount { color:#b8221d; font-weight:600; }.table-row .row-actions { flex:none; padding-right:12rpx; }
.cell-sub { display:block; margin-top:5rpx; color:#a99b8f; font-size:17rpx; font-weight:400; }
.cell-action { flex:none; width:86rpx; padding-left:4rpx; padding-right:4rpx; }
.cell-input { width:100%; height:68rpx; padding:0 4rpx; border:0; background:transparent; color:#302723; font-size:22rpx; text-align:center; }
.cell-name .cell-input { text-align:left; padding-left:12rpx; }
.cell-input-amount { color:#b8221d; font-weight:600; }
.draft-row { background:#fff9ed; }
.draft-row .cell { border-bottom:1rpx dashed #e8d5bd; }
.delete-cell { color:#aa5148; font-size:19rpx; }
.draft-mark { color:#bf9d72; font-size:26rpx; }
.inline-help { padding:16rpx 18rpx 0; color:#9a8877; font-size:21rpx; line-height:1.6; }
.form-card { padding:25rpx 22rpx; border-radius:18rpx; border:1rpx solid #eee2d5; background:rgba(255,255,255,.78); }.field { margin-bottom:23rpx; }.field-label { display:block; margin-bottom:10rpx; color:#62443a; font-size:23rpx; font-weight:600; }.required { color:#c12420; }.field-input,.field-textarea,.date-picker { width:100%; min-height:76rpx; padding:0 18rpx; border:1rpx solid #e8ddd1; border-radius:14rpx; background:#fffdfa; color:#392f29; font-size:24rpx; }.field-input { display:flex; align-items:center; }.field-textarea { padding-top:16rpx; min-height:136rpx; }.date-picker { display:flex; align-items:center; }.field-hint { display:block; margin-top:8rpx; color:#b0a397; font-size:20rpx; }
.summary-strip { display:flex; justify-content:space-between; align-items:center; padding:20rpx 22rpx; margin-bottom:18rpx; border-radius:16rpx; background:#fff; border:1rpx solid #eee3d7; }.summary-strip-title { color:#6b5c50; font-size:22rpx; }.summary-strip-amount { color:#245f63; font-size:36rpx; font-weight:700; }
